<!--
  Kestrel EDR agent installer (WiX Toolset v6).

  Silent deploy (GPO / Intune / RMM):
    msiexec /i KestrelAgent.msi /qn SERVER=edr.example.com:8443 TOKEN=<enrollment token> CA_B64=<base64 CA pem>

  The console's Enrollment page generates this exact command.
  The uninstall token is issued by the server at enrollment (one per device, shown to
  administrators on the device page in the console); the agent stores only its
  Argon2id hash. It is never printed or passed on the install command line.
  Uninstall (the token is required; a wrong token aborts the uninstall):
    msiexec /x KestrelAgent.msi /qn UNINSTALL_TOKEN=<token>

  Secrets (TOKEN, UNINSTALL_TOKEN, CA_B64) and the deferred custom-action data that
  embeds them (CA_Install, CA_Uninstall) are listed in MsiHiddenProperties and the
  custom actions use HideTarget, so none of them reach a verbose MSI log.

  Build (Windows, after a release build of kestrel-agent, i.e. cargo build with the release
  profile, and the tray app build):
    wix build installer\Kestrel.wxs -arch x64 -d Version=0.1.0 ^
      -d AgentExe=target\release\kestrel-agent.exe -d ScanExe=target\release\kestrel-scan.exe ^
      -d CaDll=target\release\kestrel_msica.dll ^
      -d TrayExe=tray\src-tauri\target\release\kestrel-tray.exe ^
      -ext WixToolset.Util.wixext -o KestrelAgent.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Kestrel EDR Agent"
           Manufacturer="Kestrel"
           Version="$(var.Version)"
           UpgradeCode="6E3A0F43-8A1B-4C55-9B5D-2F4C7E1A9D10"
           Scope="perMachine"
           Compressed="yes">

    <!--
      V-M3 (agent auto-update): RemoveExistingProducts runs after InstallExecute,
      i.e. the new version is installed over the old one first (components keep
      the same generated GUIDs, so they are shared and ref-counted) and the old
      product is removed last. This keeps the enrolled agent, its service
      registration and its state, and it means the new product is already
      registered when the old package's KestrelUninstall custom action checks
      the UPGRADINGPRODUCTCODE claim (V-M2).
      WiX: https://docs.firegiant.com/wix/schema/wxs/majorupgrade/ (Schedule);
      Windows Installer: https://learn.microsoft.com/windows/win32/msi/removeexistingproducts-action
    -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of Kestrel is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Public properties set on the msiexec command line. Hidden so they never reach the MSI log. -->
    <Property Id="SERVER" Secure="yes" />
    <Property Id="TOKEN" Secure="yes" Hidden="yes" />
    <Property Id="CA_B64" Secure="yes" Hidden="yes" />
    <!-- Required for uninstall only (M5): the server issues the token at enrollment. -->
    <Property Id="UNINSTALL_TOKEN" Secure="yes" Hidden="yes" />
    <!-- Deferred custom-action data carries TOKEN / UNINSTALL_TOKEN: hide it too. -->
    <Property Id="CA_Install" Hidden="yes" />
    <Property Id="CA_Uninstall" Hidden="yes" />

    <!-- WIX_UPGRADE_DETECTED (set by FindRelatedProducts): an upgrade of an
         installed Kestrel keeps the existing enrollment and needs no token (V-M3). -->
    <Launch Condition="Installed OR WIX_UPGRADE_DETECTED OR (SERVER AND TOKEN AND CA_B64)"
            Message="SERVER, TOKEN and CA_B64 are required. Copy the install command from the Kestrel console (Devices > Install agent, or Settings > Enrollment)." />
    <Launch Condition="VersionNT64 &gt;= 603"
            Message="Kestrel requires 64-bit Windows 10, Windows 11 or Windows Server 2019 or later." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Kestrel">
        <Component Id="AgentExe" Guid="*">
          <!-- The Rust binaries carry no version resource; DefaultVersion makes
               the package's copy "versioned" so it always replaces the
               unversioned file on disk during an upgrade (file versioning rules). -->
          <File Id="KestrelAgentExe" Source="$(var.AgentExe)" Name="kestrel-agent.exe" KeyPath="yes"
                DefaultVersion="$(var.Version)" />
        </Component>
        <!-- On-demand YARA-X scanner (kept out of the always-running agent). -->
        <Component Id="ScanExe" Guid="*">
          <File Id="KestrelScanExe" Source="$(var.ScanExe)" Name="kestrel-scan.exe" KeyPath="yes"
                DefaultVersion="$(var.Version)" />
        </Component>
        <!--
          Upgrades only (V-M3): stop the running agent service before the files
          are replaced and start the new binary afterwards. The service itself is
          registered by `kestrel-agent install` (fresh installs), not by this
          package, so nothing here runs on a fresh install or on uninstall (an
          uninstall must not stop the agent before the token is checked).
          msiexec runs as LocalSystem, which the hardened service DACL allows to
          stop and start the service.
        -->
        <Component Id="UpgradeServiceControl" Guid="*" Condition="WIX_UPGRADE_DETECTED">
          <RegistryValue Root="HKLM" Key="SOFTWARE\Kestrel\Installer" Name="UpgradeServiceControl"
                         Type="integer" Value="1" KeyPath="yes" />
          <ServiceControl Id="KestrelAgentUpgrade" Name="KestrelAgent"
                          Stop="install" Start="install" Wait="yes" />
        </Component>
        <Component Id="TrayExe" Guid="*">
          <File Id="KestrelTrayExe" Source="$(var.TrayExe)" Name="kestrel-tray.exe" KeyPath="yes" />
          <!-- Start the employee tray app at every user logon (runs unprivileged). -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                         Name="KestrelTray" Type="string" Value="&quot;[INSTALLFOLDER]kestrel-tray.exe&quot; --background" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="STATEFOLDER" Name="Kestrel">
        <Component Id="StateDir" Guid="7B0E52A4-3C1D-4F5E-9A8B-6D2C1E0F4A31">
          <CreateFolder>
            <!-- State (keys, outbox, quarantine): SYSTEM and Administrators only. -->
            <util:PermissionEx User="SYSTEM" GenericAll="yes" />
            <util:PermissionEx User="Administrators" GenericAll="yes" />
          </CreateFolder>
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- AllowAbsent="no": the feature cannot be removed on its own (V-M2). -->
    <Feature Id="Main" Title="Kestrel EDR Agent" Level="1" AllowAbsent="no">
      <ComponentRef Id="AgentExe" />
      <ComponentRef Id="UpgradeServiceControl" />
      <ComponentRef Id="TrayExe" />
      <ComponentRef Id="ScanExe" />
      <ComponentRef Id="StateDir" />
    </Feature>

    <!--
      Enrol + register the service. Runs elevated (deferred, no impersonation)
      after files are installed. The agent first verifies %ProgramData%\Kestrel
      (owner SYSTEM/Administrators, no write access for anyone else, not a
      junction) and moves an untrusted pre-existing folder aside, then writes
      its config, enrols with the server (receiving the uninstall token),
      installs and starts the service with a restricted DACL.
    -->
    <!--
      M6: tokens never go on a command line (every process-creation sensor on the
      host sees command lines) and never into the Registry/IniFile tables (Windows
      Installer logs their formatted values even for hidden properties). They
      travel only in the hidden CustomActionData of deferred actions implemented
      by kestrel-msica.dll, which pipes them to kestrel-agent.exe on stdin.
    -->
    <Binary Id="KestrelCA" SourceFile="$(var.CaDll)" />

    <SetProperty Id="CA_Install" Sequence="execute" Before="CA_Install"
                 Value="[INSTALLFOLDER]|[SERVER]|[CA_B64]|[TOKEN]" />
    <CustomAction Id="CA_Install" BinaryRef="KestrelCA" DllEntry="KestrelInstall"
                  Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />

    <!--
      V-M2: UPGRADINGPRODUCTCODE is passed to the custom action, never used in
      its condition: it is an ordinary property that `msiexec /x {PC}
      UPGRADINGPRODUCTCODE={x}` can set. KestrelUninstall waives the token only
      when that code names an installed, newer product under this UpgradeCode.
    -->
    <SetProperty Id="CA_Uninstall" Sequence="execute" Before="CA_Uninstall"
                 Value="[INSTALLFOLDER]|[UNINSTALL_TOKEN]|[UPGRADINGPRODUCTCODE]|[UpgradeCode]|[ProductVersion]|[ProductCode]" />
    <CustomAction Id="CA_Uninstall" BinaryRef="KestrelCA" DllEntry="KestrelUninstall"
                  Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />

    <!-- V-M2: partial removal (REMOVE=<feature list>) is refused outright. -->
    <CustomAction Id="CA_BlockPartialRemove"
                  Error="Removing part of Kestrel is not supported. Uninstall the whole product with the uninstall token." />

    <InstallExecuteSequence>
      <Custom Action="CA_BlockPartialRemove" After="LaunchConditions"
              Condition="REMOVE AND REMOVE&lt;&gt;&quot;ALL&quot;" />
      <!-- Fresh installs only: an upgrade keeps the enrolled identity (V-M3);
           `kestrel-agent install` also keeps an existing identity itself. -->
      <Custom Action="CA_Install" After="InstallFiles"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <!-- The agent refuses to stop without a valid uninstall token (tamper protection). -->
      <Custom Action="CA_Uninstall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
