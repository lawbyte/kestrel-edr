# Kestrel EDR server configuration. Copy to .env and fill in.
# NEVER commit .env. Back up KESTREL_MASTER_KEY separately from database backups.

# Wraps the agent CA key, TLS key, TOTP and notification secrets at rest (AES-256-GCM).
# Generate once: openssl rand -base64 32   — losing it means re-enrolling every agent.
KESTREL_MASTER_KEY=

# DNS name(s) agents and browsers use (comma separated; first = primary).
# Becomes the SANs of the agent gRPC certificate and the self-signed web certificate.
KESTREL_PUBLIC_HOSTNAME=edr.example.internal

# Published ports (host side).
KESTREL_HTTPS_PORT=443
KESTREL_GRPC_PORT=8443
# Port agents dial (if NAT/load balancer changes it).
KESTREL_GRPC_PUBLIC_PORT=8443
# Port browsers and installers use for the console and downloads, if NAT or a
# proxy changes it (default: KESTREL_HTTPS_PORT).
# KESTREL_HTTPS_PUBLIC_PORT=443

# PostgreSQL (control plane)
POSTGRES_USER=kestrel
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=kestrel

# ClickHouse (telemetry). Set CLICKHOUSE_URL= (empty) to use the Postgres fallback instead.
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=kestrel
CLICKHOUSE_PASSWORD=change-me-long-random
CLICKHOUSE_DB=kestrel

# Optional: your own web certificate (PEM, mounted from ./tls). Unset = self-signed on first run.
#TLS_CERT=/app/tls/fullchain.pem
#TLS_KEY=/app/tls/privkey.pem

# Optional: external MSI URL (default https://<host>/downloads/KestrelAgent.msi from ./installers)
#KESTREL_AGENT_MSI_URL=

# Expected agent heartbeat interval (tamper heuristics), seconds.
KESTREL_HEARTBEAT_INTERVAL_SECS=60
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs). Empty = ignore the header.
KESTREL_TRUSTED_PROXIES=
# One-time first-run setup code. Empty = random code printed in the server log at startup.
#KESTREL_SETUP_CODE=
# Private ranges webhooks / OIDC may reach (default: public addresses only).
#KESTREL_OUTBOUND_ALLOW_CIDRS=

# Build the web console into the image (0 = skip, API only).
BUILD_CONSOLE=1

RUST_LOG=info,sqlx=warn
# json | text
KESTREL_LOG_FORMAT=text
